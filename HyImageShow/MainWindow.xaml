<Window x:Class="HyImageShow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HyImageShow"
        xmlns:imageShow="clr-namespace:HyImageShow.ImageShowWPF.View"
        xmlns:viewModels="clr-namespace:HyImageShow.ImageShowWPF.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <imageShow:MainImageShow DataContext="{Binding ImageShowViewModel}" />
    </Grid>
</Window> 