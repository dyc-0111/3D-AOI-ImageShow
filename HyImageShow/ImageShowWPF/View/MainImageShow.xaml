<UserControl x:Class="HyImageShow.ImageShowWPF.View.MainImageShow"
             x:Name="self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:HyImageShow.ImageShowWPF.View"
             xmlns:vm="clr-namespace:HyImageShow.ImageShowWPF.ViewModels"
             xmlns:controls="clr-namespace:HyImageShow.ImageShowWPF.View.Controls"
             xmlns:roiCards="clr-namespace:HyImageShow.ImageShowWPF.View.RoiCards"
             xmlns:local="clr-namespace:HyImageShow.ImageShowWPF.View.Local"
             mc:Ignorable="d"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             d:DataContext="{d:DesignInstance Type=vm:ImageShowViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">
    <UserControl.Resources>
        <!-- 布林值轉換器 -->
        <view:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- ROI 卡片 DataTemplate 註冊 -->
        <DataTemplate x:Key="LineRoiCardTemplate">
            <roiCards:LineRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="RulerRoiCardTemplate">
            <roiCards:RulerRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="EllipseRoiCardTemplate">
            <roiCards:EllipseRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="PolygonRoiCardTemplate">
            <roiCards:PolygonRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="RotRectRoiCardTemplate">
            <roiCards:RotRectRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="BezierArcRoiCardTemplate">
            <roiCards:BezierArcRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="CircularArcRoiCardTemplate">
            <roiCards:CircularArcRoiCard />
        </DataTemplate>
        <DataTemplate x:Key="PointRoiCardTemplate">
            <roiCards:PointRoiCard />
        </DataTemplate>
        <roiCards:RoiCardTemplateSelector x:Key="RoiCardTemplateSelector"
            LineTemplate="{StaticResource LineRoiCardTemplate}"
            RulerTemplate="{StaticResource RulerRoiCardTemplate}"
            EllipseTemplate="{StaticResource EllipseRoiCardTemplate}"
            PolygonTemplate="{StaticResource PolygonRoiCardTemplate}"
            RotRectTemplate="{StaticResource RotRectRoiCardTemplate}"
            BezierArcTemplate="{StaticResource BezierArcRoiCardTemplate}"
            CircularArcTemplate="{StaticResource CircularArcRoiCardTemplate}"
            PointTemplate="{StaticResource PointRoiCardTemplate}" />
        
        <local:RoiPanelPopupOffsetConverter x:Key="RoiPanelPopupOffsetConverter"/>
        <local:RoiPanelPlacementConverter x:Key="RoiPanelPlacementConverter"/>
        <local:ToolbarButtonLeftConverter x:Key="ToolbarButtonLeftConverter"/>
        <local:ToolbarButtonTopConverter x:Key="ToolbarButtonTopConverter"/>
        <local:RoiButtonLeftConverter x:Key="RoiButtonLeftConverter"/>
        
        <Storyboard x:Key="ExpandRoiPanel">
            <local:GridLengthAnimation Storyboard.TargetName="RoiColumn"
                                      Storyboard.TargetProperty="Width"
                                      From="0" To="300" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CollapseRoiPanel">
            <local:GridLengthAnimation Storyboard.TargetName="RoiColumn"
                                      Storyboard.TargetProperty="Width"
                                      From="300" To="0" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="ExpandToolbar">
            <local:GridLengthAnimation Storyboard.TargetName="ToolbarRow"
                                      Storyboard.TargetProperty="Height"
                                      From="0" To="60" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CollapseToolbar">
            <local:GridLengthAnimation Storyboard.TargetName="ToolbarRow"
                                      Storyboard.TargetProperty="Height"
                                      From="60" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具列 -->
        <Border x:Name="ToolbarPanel" Grid.Row="0" MinHeight="60"
                Background="#f8f9fa"
                BorderBrush="#e9ecef"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Margin="0"
                Visibility="{Binding IsToolbarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                
                <!-- 檔案操作按鈕 -->
                <controls:ToolButton Content="新增"
                                    Command="{Binding NewFileCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Function" />
                <controls:ToolButton Content="開啟"
                                    Command="{Binding OpenFileCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Function" />
                <controls:ToolButton Content="儲存"
                                    Command="{Binding SaveFileCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Function" />
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="16,0" />
                
                <!-- 檢視操作按鈕 -->
                <controls:ToolButton Content="適應視窗"
                                    Command="{Binding FitImageCommand}"
                                    ButtonWidth="80"
                                    ButtonType="Function" />
                <controls:ToolButton Content="十字線"
                                    Command="{Binding ToggleCrossLinesCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Function" />
                <controls:ToolButton Content="清除全部"
                                    Command="{Binding ClearAllCommand}"
                                    ButtonWidth="80"
                                    ButtonType="Function" />
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="16,0" />
                
                <!-- ROI工具按鈕 -->
                <controls:ToolButton Content="標點"
                                     Command="{Binding DrawPointCommand}"
                                     ButtonWidth="60"
                                     ButtonType="Tool"
                                     IsActive="{Binding IsDrawPointActive}" />
                <controls:ToolButton Content="畫線"
                                    Command="{Binding DrawLineCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsDrawLineActive}" />
                <controls:ToolButton Content="量尺"
                                    Command="{Binding RulerCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsRulerActive}" />
                <controls:ToolButton Content="旋轉矩形"
                                    Command="{Binding RotRectRoiCommand}"
                                    ButtonWidth="80"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsRotRectRoiActive}" />
                <controls:ToolButton Content="橢圓"
                                    Command="{Binding EllipseRoiCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsEllipseRoiActive}" />
                <controls:ToolButton Content="多邊形"
                                    Command="{Binding PolygonRoiCommand}"
                                    ButtonWidth="80"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsPolygonRoiActive}" />
                <controls:ToolButton Content="貝茲弧"
                                    Command="{Binding BezierArcRoiCommand}"
                                    ButtonWidth="80"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsBezierArcRoiActive}" />
                <controls:ToolButton Content="圓弧"
                                    Command="{Binding CircularArcRoiCommand}"
                                    ButtonWidth="60"
                                    ButtonType="Tool"
                                    IsActive="{Binding IsCircularArcRoiActive}" />
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="16,0" />
                
                <!-- 滑鼠座標顯示 -->
                <TextBlock x:Name="MousePositionText"
                           Text="X: 0, Y: 0"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#666" />
            </StackPanel>
        </Border>

        <!-- 主要內容區域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RoiColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 圖片顯示區域 -->
            <Border Grid.Column="0"
                    Background="LightGray"
                    Margin="8">
                <Grid Name="MainCanvasGrid" Background="#D3D3D3">
                    <Viewbox x:Name="ImageContainer" Stretch="Uniform">
                        <Grid x:Name="ImageViewGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MainCanvasScaleTransform" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="MainCanvasTranslateTransform" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            
                            <Image x:Name="MainImage"
                                   Source="{Binding ImageSource}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            
                            <Canvas x:Name="MainCanvas"
                                    Background="Transparent"
                                    Panel.ZIndex="10"
                                    Width="{Binding ElementName=MainImage, Path=ActualWidth}"
                                    Height="{Binding ElementName=MainImage, Path=ActualHeight}" />
                        </Grid>
                    </Viewbox>
                    
                    <!-- 十字線/ROI等Overlay層 -->
                    <Canvas x:Name="OverlayCanvas"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>
            
            <!-- ROI清單面板 -->
            <Border x:Name="RoiPanel" Grid.Column="2"
                    Background="#f8f9fa"
                    BorderBrush="#e9ecef"
                    BorderThickness="1,0,0,0"
                    Margin="0,8,8,8"
                    Visibility="{Binding IsRoiPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="ROI 清單"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="16,16,16,8"
                                   Foreground="#495057" />
                        <ScrollViewer>
                            <ListView x:Name="RoiListView"
                                      ItemsSource="{Binding RoiItems}"
                                      SelectedItem="{Binding SelectedRoiItem}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="8"
                                      HorizontalContentAlignment="Stretch"
                                      VirtualizingStackPanel.IsVirtualizing="False"
                                      Focusable="True">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,8,0,8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="#90caf9"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#f5faff"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#e3f2fd"/>
                                                <Setter Property="BorderBrush" Value="#1976d2"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource RoiCardTemplateSelector}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Canvas 浮動收合/展開按鈕 -->
            <Canvas>
                <Button x:Name="FloatingButton"
                        Width="40" Height="80"
                        Canvas.Left="{Binding ElementName=MainCanvasGrid, Path=ActualWidth, Converter={StaticResource RoiButtonLeftConverter}}"
                        Canvas.Top="{Binding ElementName=MainCanvasGrid, Path=ActualHeight, Converter={StaticResource RoiPanelPopupOffsetConverter}}"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleRoiPanelCommand}"
                        Background="White"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        ToolTip="收合/展開">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#DDD"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="20"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="BorderBrush" Value="#1976d2"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.32"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <!-- 展開時向右箭頭 -->
                                        <Path Data="M9,6L15,12L9,18"
                                              Stroke="#1976d2"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRoiPanelVisible}" Value="False">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <!-- 收合時向左箭頭 -->
                                                <Path Data="M15,6L9,12L15,18"
                                                      Stroke="#1976d2"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Button>
            </Canvas>

            <!-- Canvas 浮動工具列收合/展開按鈕 -->
            <Canvas>
                <Button x:Name="ToolbarFloatingButton"
                        Width="80" Height="40"
                        Canvas.Left="{Binding ElementName=MainCanvasGrid, Path=ActualWidth, Converter={StaticResource ToolbarButtonLeftConverter}}"
                        Canvas.Top="{Binding ElementName=ToolbarPanel, Path=ActualHeight, Converter={StaticResource ToolbarButtonTopConverter}}"
                        Command="{Binding ToggleToolbarCommand}"
                        Background="White"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        ToolTip="收合/展開工具列">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#DDD"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="20"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="BorderBrush" Value="#1976d2"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.32"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <!-- 展開時向上箭頭 -->
                                        <Path Data="M6,15L12,9L18,15"
                                              Stroke="#1976d2"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToolbarVisible}" Value="False">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <!-- 收合時向下箭頭 -->
                                                <Path Data="M6,9L12,15L18,9"
                                                      Stroke="#1976d2"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Button>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
