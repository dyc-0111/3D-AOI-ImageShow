<UserControl x:Class="HyImageShow.ImageShowWPF.View.RoiCards.PointRoiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="80" d:DesignWidth="240">
    <Border CornerRadius="8" BorderBrush="#e3e3e3" BorderThickness="1" Padding="0" Background="White">
        <DockPanel>
            <!-- 色條 -->
            <Border Width="4" Background="#E53935" DockPanel.Dock="Left" CornerRadius="8,0,0,8"/>
            <StackPanel Margin="12,8,8,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 圖示 -->
                    <Ellipse Width="16" Height="16" Fill="Red" Stroke="Black" StrokeThickness="1" Margin="0,0,6,0"/>
                    <TextBlock Text="Point" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <TextBlock Text="{Binding DisplayText}" Foreground="#666" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl> 