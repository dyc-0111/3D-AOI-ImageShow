<UserControl x:Class="HyImageShow.ImageShowWPF.View.RoiCards.BezierArcRoiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="100" d:DesignWidth="240">
    <Border CornerRadius="8" BorderBrush="#e3e3e3" BorderThickness="1" Padding="0" Background="White">
        <DockPanel>
            <Border Width="4" Background="#ff7043" DockPanel.Dock="Left" CornerRadius="8,0,0,8"/>
            <StackPanel Margin="12,8,8,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌀" FontSize="16" Margin="0,0,6,0"/>
                    <TextBlock Text="BezierArc" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <TextBlock Text="{Binding Point1Text}"
                           Foreground="#666"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding Point2Text}"
                           Foreground="#666" />
                <TextBlock Text="{Binding Point3Text}" Foreground="#666" Margin="0,4,0,0" FontSize="11"/>
                <TextBlock Text="{Binding SizeText}" Foreground="#1976d2" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl> 