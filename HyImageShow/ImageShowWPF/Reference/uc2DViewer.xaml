<UserControl
    x:Class="MainFromParameter_WPF.Display.uc2DViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MainFromParameter_WPF.Display"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800" ClipToBounds="True">

    <UserControl.Resources>
        <Style x:Key="SideButtonStyle" TargetType="local:ActiveButton">
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:ActiveButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsActive" Value="True">
                    <Setter Property="Background" Value="#578FCA" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#9EC6F3" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 左側圖片區域 -->
        <Grid
            x:Name="MainGrid"
            Grid.Column="0"
            Background="Gainsboro"
            MouseEnter="MainGrid_MouseEnter"
            MouseLeave="MainGrid_MouseLeave"
            MouseLeftButtonDown="MainGrid_MouseLeftButtonDown"
            MouseLeftButtonUp="MainGrid_MouseLeftButtonUp"
            MouseMove="MainGrid_MouseMove"
            MouseRightButtonDown="MainGrid_MouseRightButtonDown"
            MouseRightButtonUp="MainGrid_MouseRightButtonUp"
            MouseWheel="MainGrid_MouseWheel">

            <Viewbox x:Name="ImageContainer" Stretch="Uniform">
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScale" />
                            <TranslateTransform x:Name="ImageTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Image x:Name="MainImage" RenderOptions.BitmapScalingMode="HighQuality" />

                    <Canvas x:Name="SelectionCanvas" Background="Transparent" Panel.ZIndex="10">
                        <Rectangle
                            x:Name="SelectionBox"
                            Fill="Transparent"
                            Stroke="Red"
                            StrokeThickness="2"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SelectionNumber"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="Red"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- 右側控制按鈕 -->
        <Grid x:Name="RightButtonPanel" Grid.Column="1" Background="LightGray">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                <local:ActiveButton x:Name="NewFileButton" Click="NewFileButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="開新檔案">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/add.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="OpenButton" Click="OpenButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="載入舊檔">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/Open.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="EditButton" Click="EditButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="編輯區域">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/Edit.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="AddButton" Click="AddButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="加入新區域">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/plus.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="DeleteButton" Click="DeleteButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="刪除區域">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/Delete.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="ResetZoomButton" Click="ResetZoomButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="重置縮放">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/FullScreen.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="LevelingButton" Click="LevelingButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="三點校正">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/3point.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="SelectROIButton" Click="SelectROIButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="ROI框選">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/selection.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="LineButton" Click="LineButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="拉取線條">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/line-segment.png" Stretch="Uniform" />
                </local:ActiveButton>
                <local:ActiveButton x:Name="CancelButton" Click="CancelButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="取消動作">
                    <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/Delete.png" Stretch="Uniform" />
                </local:ActiveButton>
            </StackPanel>

            <local:ActiveButton x:Name="SaveButton" Grid.Row="1" Margin="0,0,0,20" VerticalAlignment="Bottom" Click="SaveButton_Click" Style="{StaticResource SideButtonStyle}" ToolTip="儲存資料">
                <Image Width="30" Height="30" Source="pack://application:,,,/MainFromParameter_WPF;component/Display/Resources/save.png" Stretch="Uniform" />
            </local:ActiveButton>
        </Grid>
    </Grid>
</UserControl>